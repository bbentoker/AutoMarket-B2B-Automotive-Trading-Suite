# SECURITY-SANITIZED: All values below are placeholders for public showcase.
# In the real deployment these contained live credentials and have been
# rotated. Copy this file to .env and supply your own values.

DEBUG=false
NODE_ENV=development

DB_NAME=automarket_db
DB_USER=automarket_user
DB_PASSWORD=change_me_strong_random_value
DB_HOST=db.automarket.example.com
DB_PORT=5432
DB_SSL_MODE=require

DO_SPACES_KEY=PLACEHOLDER_SPACES_ACCESS_KEY
DO_SPACES_SECRET=PLACEHOLDER_SPACES_SECRET_KEY
DO_BUCKET_NAME=automarket-assets

GPT_KEY=PLACEHOLDER_OPENAI_API_KEY
JP_CARS_KEY=PLACEHOLDER_JP_CARS_API_KEY

MAILGUN_KEY=PLACEHOLDER_MAILGUN_API_KEY
MAILGUN_DOMAIN=automarket.example.com

RESEND_KEY=PLACEHOLDER_RESEND_API_KEY

NEWSLETTER_BATCH_SIZE=2
NEWSLETTER_BATCH_DELAY=1000

SENDER_EMAIL=info@automarket.example.com
SENDER_NAME=AutoMarket

# SECURITY-SANITIZED: Original production value was a weak literal 'secret'.
JWT_SECRET=change_me_use_a_long_random_string

FRONTEND_URL=https://browse.automarket.example.com
DASHBOARD_URL=https://dashboard.automarket.example.com
LANDING_URL=https://buy.automarket.example.com

SCRAPED_LISTINGS_START_DATE=2025-07-27 00:00:00

BRIGHT_DATA_API_KEY=PLACEHOLDER_BRIGHT_DATA_API_KEY
BRIGHT_DATA_API_UNLOCKER=PLACEHOLDER_UNLOCKER_NAME

OXY_LABS_USERNAME=PLACEHOLDER_OXYLABS_USERNAME
OXY_LABS_PASSWORD=PLACEHOLDER_OXYLABS_PASSWORD

# ENABLE_WEEKLY_REPORT_CRON=true
# ENABLE_EXPIRE_LISTINGS_CRON=true
ENABLE_WISHLIST_SENDING_CRON=true

# Zoho CRM (optional integration)
ZOHO_API_BASE_URL=https://www.zohoapis.eu/crm/v3
ZOHO_CLIENT_ID=PLACEHOLDER_ZOHO_CLIENT_ID
ZOHO_CLIENT_SECRET=PLACEHOLDER_ZOHO_CLIENT_SECRET
ZOHO_REDIRECT_URI=https://api.automarket.example.com/auth/zoho/callback
