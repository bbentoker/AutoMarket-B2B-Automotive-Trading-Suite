# SECURITY-SANITIZED: All values below are placeholders for public showcase.
# In the real deployment these contained live credentials and have been
# rotated. Copy this file to .env and supply your own values.

# ListingSiteA Scraper Configuration Example

# Job Control - Set to true/false to enable/disable jobs
# Jobs will run once on startup if enabled, then on daily schedule
SCRAPER_ON=false
CHECKER_ON=true

# With the above settings:
# - Scraper will NOT run (neither on startup nor on schedule)
# - Checker will run once on startup, then daily at 2 AM UTC

# Database Configuration
DB_HOST=db.automarket.example.com
DB_PORT=5432
DB_NAME=automarket_db
DB_USER=automarket_user
DB_PASS=change_me_strong_random_value

# Memory Optimization
NODE_OPTIONS="--expose-gc --max-old-space-size=512"

# Debug Mode (optional)
DEBUG=false

# Localhost Development Mode
# Set NODE_ENV=development and LOCALHOST_USERS=true to use predefined user array instead of API
NODE_ENV=production
LOCALHOST_USERS=false

# Processing Configuration (now sequential by default)
USER_PROCESSING_CONCURRENCY=1
ADVERT_PROCESSING_CONCURRENCY=1
MAKE_PROCESSING_CONCURRENCY=1

# MinIO S3-Compatible Storage Configuration
MINIO_ROOT_USER=PLACEHOLDER_MINIO_USER
MINIO_ROOT_PASSWORD=change_me_strong_random_value
MINIO_BUCKET=automarket-assets

# Listing site target (generic placeholder)
LISTING_SITE_A_URL=https://listingsitea.example.com

# Oxylabs Residential Proxy (required for production to bypass IP blocking)
OXYLABS_PROXY_NAME=PLACEHOLDER_OXYLABS_PROXY_NAME
OXYLABS_PROXY_PASSWORD=PLACEHOLDER_OXYLABS_PROXY_PASSWORD

# Legacy AWS S3 Configuration (fallback support)
# AWS_ACCESS_KEY_ID=PLACEHOLDER_AWS_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=PLACEHOLDER_AWS_SECRET_KEY
# AWS_S3_BUCKET=automarket-assets
